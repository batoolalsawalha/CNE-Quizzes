  {
    "id": "CALC1-FIN-004",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-final-2024",
    "topicId": "top-c1-deriv",
    "question": "If f(3) = -2, f'(3) = 4, and g(x) = (2x + 1) / f(x), then g'(3) =",
    "options": [
      {
        "id": "a",
        "text": "6"
      },
      {
        "id": "b",
        "text": "8"
      },
      {
        "id": "c",
        "text": "-6"
      },
      {
        "id": "d",
        "text": "-8"
      }
    ],
    "correctAnswer": "d",
    "explanation": "By the quotient rule: g'(3) = [2*f(3) - f'(3)*(2(3)+1)] / [f(3)]² = [2(-2) - 4(7)] / (-2)² = (-4 - 28) / 4 = -32 / 4 = -8.",
    "difficulty": "Medium",
    "sourceFile": "Final calcu 2023-2024.pdf",
    "sourcePage": 1,
    "status": "Verified",
    "createdAt": "2026-09-28T16:31:10.966Z",
    "updatedAt": "2026-09-28T16:31:10.966Z"
  },
  {
    "id": "CALC1-FIN-005",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-final-2024",
    "topicId": "top-c1-deriv",
    "question": "If f(x) = 2x - 1, then f⁻¹(x) =",
    "options": [
      {
        "id": "a",
        "text": "(x - 1) / 2"
      },
      {
        "id": "b",
        "text": "(x + 1) / 2"
      },
      {
        "id": "c",
        "text": "x + 2"
      },
      {
        "id": "d",
        "text": "x - 2"
      }
    ],
    "correctAnswer": "b",
    "explanation": "Let y = 2x - 1 => 2x = y + 1 => x = (y + 1) / 2. Hence f⁻¹(x) = (x + 1) / 2.",
    "difficulty": "Easy",
    "sourceFile": "Final calcu 2023-2024.pdf",
    "sourcePage": 1,
    "status": "Verified",
    "createdAt": "2026-09-28T16:31:10.966Z",
