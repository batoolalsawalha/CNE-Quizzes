  {
    "id": "CALC1-MID-004",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-mid",
    "topicId": "top-c1-limits",
    "question": "If the domain of the function y = f(x) is (4, 7], then the domain of g(x) = f(2 - x) is:",
    "options": [
      {
        "id": "a",
        "text": "[4, 7)"
      },
      {
        "id": "b",
        "text": "(4, 7]"
      },
      {
        "id": "c",
        "text": "(-5, -2]"
      },
      {
        "id": "d",
        "text": "[-5, -2)"
      }
    ],
    "correctAnswer": "d",
    "explanation": "4 < 2 - x ≤ 7 => subtracting 2 gives: 2 < -x ≤ 5 => multiplying by -1 (and reversing inequality signs): -5 ≤ x < -2, which in interval notation is [-5, -2).",
    "difficulty": "Medium",
