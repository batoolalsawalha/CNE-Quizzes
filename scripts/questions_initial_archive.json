  {
    "id": "CIRC1-MID-002",
    "subjectId": "subj-circ1",
    "quizId": "quiz-circ1-mid-2017",
    "topicId": "top-ee1-basic",
    "question": "To move charge q = 6 C from point a to point b requires -30 J. The voltage drop Vab is:",
    "options": [
