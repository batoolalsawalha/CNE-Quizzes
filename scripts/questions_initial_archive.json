  {
    "id": "CALC1-MID-002",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-mid",
    "topicId": "top-c1-limits",
    "question": "Given that f(x) = 1 / (x - 2) and g(x) = 1 / x, then the domain of the composite function (f ∘ g) is:",
    "options": [
      {
        "id": "a",
        "text": "ℝ \\ {0}"
      },
      {
        "id": "b",
        "text": "ℝ \\ {1/2}"
      },
      {
        "id": "c",
        "text": "ℝ \\ {0, 1/2}"
      },
      {
        "id": "d",
        "text": "ℝ \\ {0, 2}"
      }
    ],
    "correctAnswer": "c",
    "explanation": "(f ∘ g)(x) = f(g(x)) = 1 / (1/x - 2). For g(x) to be defined: x ≠ 0. For f(g(x)) to be defined: 1/x - 2 ≠ 0 => 1/x ≠ 2 => x ≠ 1/2. Therefore Domain = ℝ \\ {0, 1/2}.",
    "difficulty": "Medium",
    "sourceFile": "ميد كالكولاس 1.pdf",
    "sourcePage": 1,
    "status": "Verified",
    "createdAt": "2026-09-28T16:31:10.966Z",
    "updatedAt": "2026-09-28T16:31:10.966Z"
