  {
    "id": "CALC1-FIN-016",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-final-2024",
    "topicId": "top-c1-curve",
    "question": "The relative minimum of the function f(x) = (1/3)x³ - 3x² + 5x + 10 occurs when x =",
    "options": [
      {
        "id": "a",
        "text": "3"
      },
      {
        "id": "b",
        "text": "1"
      },
      {
        "id": "c",
        "text": "2"
      },
      {
        "id": "d",
        "text": "5"
      }
    ],
    "correctAnswer": "d",
    "explanation": "f'(x) = x² - 6x + 5 = (x - 1)(x - 5) = 0 => critical points x = 1, 5. f''(x) = 2x - 6. f''(1) = -4 < 0 (local max), f''(5) = 4 > 0 (local min). Hence relative minimum occurs at x = 5.",
    "difficulty": "Medium",
    "sourceFile": "Final calcu 2023-2024.pdf",
    "sourcePage": 3,
    "status": "Verified",
    "createdAt": "2026-09-28T16:31:10.966Z",
