  {
    "id": "CALC1-MID-007",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-mid",
    "topicId": "top-c1-limits",
    "question": "If f(x) = x² + 4x + 7 for x ∈ (-∞, k] is a one-to-one function, then the largest possible value of k is:",
    "options": [
      {
        "id": "a",
        "text": "4"
      },
      {
        "id": "b",
        "text": "2"
      },
      {
        "id": "c",
        "text": "-2"
      },
      {
        "id": "d",
        "text": "-4"
      }
    ],
    "correctAnswer": "c",
    "explanation": "The parabola f(x) has its vertex at x = -b / (2a) = -4 / 2 = -2. It is monotonic on (-∞, -2] and [-2, ∞). For x ∈ (-∞, k] to be one-to-one, k cannot exceed the vertex at -2.",
    "difficulty": "Medium",
    "sourceFile": "ميد كالكولاس 1.pdf",
    "sourcePage": 2,
    "status": "Verified",
    "createdAt": "2026-09-28T16:31:10.967Z",
