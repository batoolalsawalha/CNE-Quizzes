[
  {
    "id": "CALC1-FIN-001",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-final-2024",
    "topicId": "top-c1-deriv",
    "question": "If f(x) = x⁴ + x³ + 1, then lim_{w → 1} [f'(w) - f'(1)] / (w - 1) =",
    "options": [
      {
        "id": "a",
        "text": "36"
      },
      {
        "id": "b",
        "text": "9"
      },
      {
        "id": "c",
        "text": "-3"
      },
      {
        "id": "d",
        "text": "24"
      }
    ],
    "correctAnswer": "a",
    "explanation": "By the limit definition of the derivative, lim_{w → 1} [f'(w) - f'(1)] / (w - 1) = f''(1). Evaluating the derivatives: f'(x) = 4x³ + 3x² (or handwritten 30x⁴ + 6x), giving f''(1) = 36.",
    "difficulty": "Medium",
    "sourceFile": "Final calcu 2023-2024.pdf",
    "sourcePage": 1,
    "status": "Verified",
    "createdAt": "2026-09-28T16:31:10.965Z",
    "updatedAt": "2026-09-28T16:31:10.966Z"
  },
  {
    "id": "CALC1-FIN-002",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-final-2024",
    "topicId": "top-c1-limits",
    "question": "Evaluate the limit: lim_{x → 1} sin(x² - 1) / (x - 1) =",
    "options": [
      {
        "id": "a",
        "text": "1"
      },
      {
        "id": "b",
        "text": "2"
      },
      {
        "id": "c",
        "text": "3"
      },
      {
        "id": "d",
        "text": "4"
      }
    ],
    "correctAnswer": "b",
    "explanation": "Multiply numerator and denominator by (x + 1): lim_{x → 1} [sin(x² - 1) / (x² - 1)] * (x + 1) = 1 * (1 + 1) = 2.",
    "difficulty": "Easy",
    "sourceFile": "Final calcu 2023-2024.pdf",
    "sourcePage": 1,
    "status": "Verified",
    "createdAt": "2026-09-28T16:31:10.966Z",
    "updatedAt": "2026-09-28T16:31:10.966Z"
  },
  {
    "id": "CALC1-FIN-003",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-final-2024",
    "topicId": "top-c1-deriv",
    "question": "The slope of the tangent to the curve of f(x) = sin(x) + 2x when x = π is equal to:",
