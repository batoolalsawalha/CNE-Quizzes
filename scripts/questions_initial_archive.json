      },
      {
        "id": "c",
        "text": "θ + cos θ + c"
      },
      {
        "id": "d",
        "text": "θ - cos θ + c"
      }
    ],
    "correctAnswer": "d",
    "explanation": "csc θ = 1 / sin θ, so sin²θ csc θ = sin θ. Therefore ∫ (1 + sin θ) dθ = θ - cos θ + c.",
    "difficulty": "Easy",
    "sourceFile": "Final calcu 2023-2024.pdf",
    "sourcePage": 2,
    "status": "Verified",
    "createdAt": "2026-09-28T16:31:10.966Z",
