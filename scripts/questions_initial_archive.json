  {
    "id": "CALC1-MID-005",
    "subjectId": "subj-calc1",
    "quizId": "quiz-calc1-mid",
    "topicId": "top-c1-limits",
    "question": "The solution set of the inequality e^(7x) > 2e^(3x) is:",
    "options": [
      {
        "id": "a",
        "text": "((ln 2)/4, ∞)"
      },
      {
        "id": "b",
        "text": "(-∞, (ln 2)/4)"
